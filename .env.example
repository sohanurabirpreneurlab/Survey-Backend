NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
INVITATION_EMAIL_HASH_SECRET=replace-me
INVITATION_EMAIL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RESPONDENT_SESSION_SECRET=replace-me
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Survey Platform
RESPONDENT_COOKIE_NAME=survey_session
RESPONDENT_SESSION_TTL_MINUTES=1440
