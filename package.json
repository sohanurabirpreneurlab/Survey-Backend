{
  "name": "survey-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready survey platform backend scaffold",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "db:schema:generate": "supabase db dump --schema public --file database/schema/current-schema.sql",
    "db:types:generate": "supabase gen types typescript --local > src/database/generated/database.types.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "@supabase/supabase-js": "^2.56.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
